–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–Р–